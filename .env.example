# Copie este arquivo para .env.local e preencha. NUNCA versionar .env.local (já está no
# .gitignore). Banco: PostgreSQL próprio (docs/ARQUITETURA.md, decisão 47).

# Senha do superusuário do container de banco (docker-compose.yml).
PG_SUPERUSER_PASSWORD=
# Superusuário, para `npm run db:migrar` criar banco/usuário e aplicar as migrations.
DATABASE_ADMIN_URL=postgres://postgres:<senha>@127.0.0.1:5433/postgres
# Conexão do app (usuário próprio do cliente, sem permissão fora do seu banco).
DATABASE_URL=postgres://app_barbearia:<senha>@127.0.0.1:5433/barbearia
# A mesma conexão vista de dentro do Docker (o banco é o serviço "db" do compose).
DATABASE_URL_DOCKER=postgres://app_barbearia:<senha>@db:5432/barbearia

# Opcional: pasta de logo e fotos (padrão dados/arquivos; no Docker, /dados/arquivos).
# ARQUIVOS_DIR=

# --- Só para scripts/copiar-do-supabase.mjs (cópia dos dados antigos) ---
# Projeto Supabase de onde os dados são copiados. Depois da migração, pode apagar.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=   (padrão aws-0-sa-east-1.pooler.supabase.com)
